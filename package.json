{
  "name": "gitcord",
  "version": "1.0.0",
  "description": "Production-ready read-only Git integration Discord bot",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "git",
    "discord",
    "bot",
    "github",
    "gitlab",
    "gitea",
    "forgejo",
    "monitoring"
  ],
  "author": "Gitcord Contributors",
  "license": "MIT",
  "dependencies": {
    "@discordjs/builders": "1.6.5",
    "@discordjs/formatters": "0.3.2",
    "@discordjs/rest": "2.0.1",
    "@discordjs/util": "1.0.1",
    "@discordjs/ws": "1.0.2",
    "better-sqlite3": "13.0.3",
    "discord-api-types": "0.37.50",
    "discord.js": "14.13.0",
    "dotenv": "16.4.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "20.17.19",
    "tsx": "4.19.3",
    "typescript": "5.7.3",
    "vitest": "3.0.7"
  },
  "overrides": {
    "@discordjs/builders": "1.6.5",
    "@discordjs/formatters": "0.3.2",
    "@discordjs/util": "1.0.1",
    "discord-api-types": "0.37.50"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
